# ─── Proof-of-Compute environment variables ─────────────────────────────────
#
# Copy this file to .env and fill in real values when moving beyond the demo.
# All VITE_ variables are exposed to the browser bundle — do NOT put secrets here.

# Set to "false" to switch from mock adapters to real API + chain adapters.
# Leave unset or set to "true" to use the built-in mock implementation.
VITE_USE_MOCK=true

# RPC endpoint for the EVM network (Hardhat local, Sepolia, etc.)
# VITE_RPC_URL=http://127.0.0.1:8545

# Deployed ProofOfCompute contract address.
# Leave blank until the contract is deployed.
# VITE_CONTRACT_ADDRESS=0x...

# Optional: block explorer base URL for transaction links.
# VITE_EXPLORER_BASE=https://sepolia.etherscan.io/tx/
