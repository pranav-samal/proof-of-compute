# ─── Proof-of-Compute Frontend Environment Variables ──────────────────────────
#
# Copy this file to .env and fill in real values.
# All VITE_ variables are exposed to the browser bundle — do NOT put secrets here.

# Set to "false" to switch from mock adapters to real API + chain adapters.
# Leave unset or set to "true" to use the built-in mock implementation.
VITE_USE_MOCK=false

# RPC endpoint for the EVM network (Hardhat local, Sepolia, etc.)
VITE_RPC_URL=http://127.0.0.1:8545

# Chain ID: 31337 for Hardhat local, 11155111 for Sepolia
VITE_CHAIN_ID=31337

# Deployed contract addresses (from contracts/deployments/localhost.json)
VITE_CONTRACT_PROVIDER_REGISTRY=0x5fbdb2315678afecb367f032d93f642f64180aa3
VITE_CONTRACT_VERIFICATION_POLICY=0xe7f1725e7734ce288f8367e1bb143e90bb3f0512
VITE_CONTRACT_JOB_ESCROW=0x9fe46736679d2d9a65f0992f2272de9f3c7fa6e0

# Block explorer base URL for transaction links
VITE_EXPLORER_BASE=https://sepolia.etherscan.io/tx/

# Backend API base URL
VITE_BACKEND_URL=http://localhost:3001
