# Provider agent Docker image
# Build: docker build -f Dockerfile.provider -t poc-provider:latest .
# Run:   docker run --env-file .env poc-provider:latest

FROM node:20-slim

WORKDIR /app

# Install dependencies first (cached layer)
COPY package.json ./
RUN npm install --omit=dev

# Copy TypeScript source and build config
COPY tsconfig.json ./
COPY shared/ ./shared/
COPY jobs/ ./jobs/
COPY provider/ ./provider/

# Install dev deps for build then prune
RUN npm install && npx tsc && npm prune --omit=dev

ENV NODE_ENV=production

CMD ["node", "dist/provider/index.js"]
