# agents/.env.example
# Copy to agents/.env and fill in private keys. NEVER commit agents/.env.

# ── Blockchain ──────────────────────────────────────────────────────────────
RPC_URL=http://127.0.0.1:8545
CHAIN_ID=31337

# ── Contract addresses (deployed by Member 1 on localhost) ──────────────────
PROVIDER_REGISTRY_ADDRESS=0x5FbDB2315678afecb367f032d93F642f64180aa3
JOB_ESCROW_ADDRESS=0x9fE46736679d2D9a65F0992F2272dE9f3c7fa6e0

# ── Wallets ─────────────────────────────────────────────────────────────────
# Provider agent private key (hex, with or without 0x prefix).
# Must be a different account from the deployer and verifier.
# Hardhat account #1: 0x59c6995e998f97a5a0044966f0945389dc9e86dae88c7a8412f4603b6b78690d
PROVIDER_PRIVATE_KEY=

# Verifier service private key (hex, with or without 0x prefix).
# Must be a different account from provider.
# Hardhat account #2: 0x5de4111afa1a4b94908f83103eb1f1706367c2e68ca870fc3fb9a804cdab365a
VERIFIER_PRIVATE_KEY=

# ── Backend (Member 2) ──────────────────────────────────────────────────────
BACKEND_URL=http://localhost:3001

# IPFS gateway for direct reads (backend proxies via GET /ipfs/:cid by default)
IPFS_GATEWAY=https://gateway.pinata.cloud/ipfs/

# ── Runtime ─────────────────────────────────────────────────────────────────
# Set to "true" to skip Docker and run workloads directly in Node.js.
# Required for local dev without Docker daemon installed.
NO_DOCKER=false

# Container runtime binary name: "docker" (default) or "podman"
CONTAINER_RUNTIME=docker

# Maximum seconds a job container is allowed to run before it is killed.
MAX_JOB_DURATION_SECONDS=300

# ── Demo / testing flags ────────────────────────────────────────────────────
# ⚠  DEMO ONLY — set to "true" to submit a deliberately wrong result hash.
# This triggers verifier detection and provider slashing in the demo.
# MUST be "false" (or unset) in any real or production deployment.
AGENT_CHEAT_MODE=false
