# /agents environment variables
# Copy to .env and fill in real values. Never commit .env.

# Provider agent wallet (no 0x prefix)
PROVIDER_PRIVATE_KEY=

# Verifier agent wallet (no 0x prefix)
VERIFIER_PRIVATE_KEY=

# Blockchain RPC
RPC_URL=
CHAIN_ID=

# Contract addresses (copy from contracts/deployments/<network>.json)
PROVIDER_REGISTRY_ADDRESS=
JOB_ESCROW_ADDRESS=
VERIFIER_REGISTRY_ADDRESS=

# IPFS
IPFS_GATEWAY=
PINATA_API_KEY=
PINATA_SECRET_KEY=

# Debug: set to "true" to make the provider return a deliberately wrong result
# Used to demonstrate slashing in the demo
AGENT_CHEAT_MODE=false

# Container / runtime settings
CONTAINER_RUNTIME=docker
MAX_JOB_DURATION_SECONDS=300
