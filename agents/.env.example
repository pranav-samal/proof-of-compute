# agents/.env.example
# Copy to agents/.env and fill in values. NEVER commit agents/.env.
#
# Provider agent private key (hex, with or without 0x prefix)
# Use a different address from the deployer and verifier.
PROVIDER_PRIVATE_KEY=

# Verifier service private key (hex, with or without 0x prefix)
# Use a different address from the deployer and provider.
VERIFIER_PRIVATE_KEY=

# EVM JSON-RPC endpoint
RPC_URL=http://127.0.0.1:8545
CHAIN_ID=31337

# Contract addresses — copy from contracts/deployments/localhost.json after Member 1 deploys
PROVIDER_REGISTRY_ADDRESS=
JOB_ESCROW_ADDRESS=

# Backend URL (Member 2)
BACKEND_URL=http://localhost:3001

# IPFS gateway for direct reads (backend proxies via GET /ipfs/:cid by default)
IPFS_GATEWAY=https://gateway.pinata.cloud/ipfs/

# Container runtime: "docker" (default) or "podman"
CONTAINER_RUNTIME=docker

# Set to "true" to skip Docker and run workloads directly in Node.js.
# Required for local dev without Docker daemon.
NO_DOCKER=false

# ⚠  DEMO ONLY — set to "true" to submit a deliberately wrong result hash.
# This triggers verifier detection and provider slashing in the demo.
# MUST be "false" in any real deployment.
AGENT_CHEAT_MODE=false

# Maximum seconds a job container is allowed to run before it is killed.
MAX_JOB_DURATION_SECONDS=300
