{
  "name": "proof-of-compute-backend",
  "version": "0.1.0",
  "private": true,
  "description": "Backend API, event indexer, and IPFS helpers for Proof-of-Compute",
  "main": "dist/index.js",
  "scripts": {
    "dev": "nodemon --exec tsx src/index.ts",
    "build": "tsc",
    "start": "node dist/index.js",
    "test": "vitest run",
    "test:coverage": "vitest run --coverage",
    "migrate": "tsx src/db/migrate.ts"
  },
  "dependencies": {
    "dotenv": "^16.4.5",
    "ethers": "^6.13.0",
    "express": "^4.19.2",
    "node-fetch": "^3.3.2",
    "sql.js": "^1.12.0"
  },
  "devDependencies": {
    "@types/express": "^4.17.21",
    "@types/node": "^20.14.0",
    "@types/sql.js": "^1.4.9",
    "@types/supertest": "^6.0.2",
    "nodemon": "^3.1.4",
    "supertest": "^7.0.0",
    "tsx": "^4.16.0",
    "typescript": "^5.4.5",
    "vitest": "^1.6.0"
  }
}