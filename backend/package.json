{
  "name": "proof-of-compute-backend",
  "version": "0.1.0",
  "private": true,
  "description": "Backend API, event indexer, and IPFS helpers for Proof-of-Compute",
  "main": "dist/index.js",
  "scripts": {
    "dev": "nodemon --exec \"npx tsx\" src/index.ts",
    "build": "tsc",
    "start": "node dist/index.js",
    "test": "vitest run",
    "test:coverage": "vitest run --coverage",
    "migrate": "npx tsx src/db/migrate.ts",
    "seed": "npx tsx src/scripts/seed.ts"
  },
  "dependencies": {
    "@types/cors": "^2.8.19",
    "better-sqlite3": "^11.5.0",
    "cors": "^2.8.6",
    "dotenv": "^16.4.5",
    "ethers": "^6.13.0",
    "express": "^4.19.2",
    "node-fetch": "^3.3.2"
  },
  "devDependencies": {
    "@types/better-sqlite3": "^7.6.11",
    "@types/express": "^4.17.21",
    "@types/node": "^20.14.0",
    "@types/supertest": "^6.0.2",
    "nodemon": "^3.1.4",
    "supertest": "^7.0.0",
    "tsx": "^4.16.0",
    "typescript": "^5.4.5",
    "vitest": "^1.6.0"
  }
}
