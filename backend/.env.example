# /backend environment variables — from SPEC.md §11
# Copy to .env and fill in real values. Never commit .env.

# Server
PORT=3001
NODE_ENV=development

# Database — path to the SQLite file (directory is auto-created)
DATABASE_PATH=./data/poc.db

# Blockchain RPC
RPC_URL=http://127.0.0.1:8545
CHAIN_ID=31337

# Confirmations to wait before indexing a block
CONFIRMATIONS=2

# Contract addresses — copy from contracts/deployments/localhost.json after Member 1 deploys
PROVIDER_REGISTRY_ADDRESS=
VERIFICATION_POLICY_ADDRESS=
JOB_ESCROW_ADDRESS=

# Indexer start block (set to deployment block to skip genesis blocks)
INDEXER_START_BLOCK=0

# Pinata IPFS (get JWT from pinata.cloud — free tier is fine for dev)
PINATA_JWT=

# IPFS gateway for reads
IPFS_GATEWAY=https://gateway.pinata.cloud/ipfs/

# Optional: local Kubo IPFS node
IPFS_LOCAL_API=http://127.0.0.1:5001
