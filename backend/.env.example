# /backend environment variables
# Copy to .env and fill in real values. Never commit .env.

# Server
PORT=3001
NODE_ENV=development

# Database
DATABASE_URL=

# Blockchain RPC
RPC_URL=
CHAIN_ID=

# Contract addresses (copy from contracts/deployments/<network>.json)
PROVIDER_REGISTRY_ADDRESS=
JOB_ESCROW_ADDRESS=
RECEIPT_ADDRESS=

# IPFS / Pinata
PINATA_API_KEY=
PINATA_SECRET_KEY=
IPFS_GATEWAY=

# Optional: indexer start block
INDEXER_START_BLOCK=0
