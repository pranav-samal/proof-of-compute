# /contracts environment variables
# Copy to .env and fill in real values. Never commit .env.

# Private key for the deployer wallet (no 0x prefix)
DEPLOYER_PRIVATE_KEY=

# RPC URL for the target network
RPC_URL=

# Etherscan / block explorer API key (for contract verification)
ETHERSCAN_API_KEY=

# Optional: Hardhat network name override
HARDHAT_NETWORK=localhost
